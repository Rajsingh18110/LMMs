/* dark.qss - Premium LMMs Theme (Base) */

/* =========================================
   Base Application Styling
   ========================================= */
QWidget {
    color: #E2E8F0;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Geist", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
}

/* =========================================
   Navigation & Activity Bar
   ========================================= */
#NavButton {
    background-color: transparent;
    color: #64748B;
    text-align: left;
    padding: 10px 15px;
    border-radius: 8px;
    border: none;
    font-weight: 600;
    font-size: 14px;
}

#NavButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #E2E8F0;
}

#NavButton:checked {
    background-color: #8B5CF6;
    color: #ffffff;
    /* Soft shadow illusion via border */
    border: 1px solid #7C3AED;
}

/* =========================================
   Scrollbars (Thin, Mac-like)
   ========================================= */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.1);
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.2);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.1);
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.2);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* =========================================
   Inputs & Fields
   ========================================= */
QTextEdit, QPlainTextEdit, QLineEdit, QComboBox {
    background-color: #1B1926;
    color: #E2E8F0;
    border: 1px solid #2D2A3E;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: rgba(139, 92, 246, 0.3);
}

QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus, QComboBox:focus {
    border: 1px solid #8B5CF6;
    background-color: #12111A;
}

/* =========================================
   Buttons
   ========================================= */
QPushButton {
    background-color: #1B1926;
    color: #E2E8F0;
    border: 1px solid #2D2A3E;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2D2A3E;
    border: 1px solid #4C4666;
}

QPushButton:pressed {
    background-color: #12111A;
}

/* =========================================
   Splitters (Invisible borders)
   ========================================= */
QMainWindow::separator {
    background: transparent;
    width: 6px;
    height: 6px;
}
QMainWindow::separator:hover {
    background: rgba(139, 92, 246, 0.3);
}
QSplitter::handle {
    background: transparent;
}

/* =========================================
   Window Controls
   ========================================= */
QPushButton#minimizeBtn, QPushButton#maximizeBtn, QPushButton#closeBtn {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: transparent;
    border: none;
    margin: 2px;
}
QPushButton#minimizeBtn:hover, QPushButton#maximizeBtn:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
QPushButton#closeBtn:hover {
    background-color: #ef4444;
}

/* =========================================
   Title Bar
   ========================================= */
#CustomTitleBar {
    background-color: transparent;
    color: #94A3B8;
}

/* =========================================
   Tree View (Explorer)
   ========================================= */
QTreeView#explorerTree::branch {
    background-color: transparent;
}
QTreeView#explorerTree::branch:has-siblings:!adjoins-item {
    border-left: 1px solid #2D2A3E;
    margin-left: 10px;
}
QTreeView#explorerTree::branch:has-siblings:adjoins-item {
    border-left: 1px solid #2D2A3E;
    margin-left: 10px;
}
QTreeView#explorerTree::branch:!has-children:!has-siblings:adjoins-item {
    border-left: 1px solid #2D2A3E;
    margin-left: 10px;
}

/* =========================================
   Status Bar (Footer)
   ========================================= */
QWidget#CustomStatusBar QLabel {
    background-color: transparent;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 500;
    padding: 0 8px;
    border: none;
}
QWidget#CustomStatusBar QPushButton {
    background-color: transparent;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 500;
    padding: 0 10px;
    border: none;
    border-radius: 6px;
    margin: 2px;
}
QWidget#CustomStatusBar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #E2E8F0;
}

